{
  "name": "marlin-seafood-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT,PWA\" -c \"cyan.bold,magenta.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:pwa\"",
    "dev:admin": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vite build",
    "build:server": "npm --prefix server run build",
    "preview": "vite preview",
    "dev:pwa": "npm --prefix mobile-pwa run dev",
    "build:pwa": "npm --prefix mobile-pwa run build",
    "test:pwa": "npm --prefix mobile-pwa run test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^5.4.2"
  }
}
